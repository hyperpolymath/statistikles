#
# debt.a2ml — Meander debt list
# Things found but not fixed. Carried between sessions.
# Becomes the next session's Phase 0 input.
#
# Reference: ADR-002 in standards/agentic-a2ml/docs/

[metadata]
version = "1.0.0"
last-updated = "2026-09-25"

# ============================================================================
# DEBT ITEMS
# ============================================================================
# Each item has: component, issue, effort (easy|medium|hard), impact (high|medium|low),
# priority (should|could), and discovered date.
#
# Items are consumed (removed) when fixed. New items are added at session end.
# The debt list prevents the "one more wave" loop — found things are persisted,
# not forgotten, and not used as justification for infinite meandering.

# ============================================================================
# SHOULD — would fix next wave
# ============================================================================
# These are inputs for the next session if the user says "keep going".
#
# Example:
# [[debt.should]]
# component = "system-tools/monitoring/observatory"
# issue = "Stale duplicate of root observatory/"
# effort = "easy"
# impact = "medium"
# discovered = "2026-03-23"

# ============================================================================
# COULD — would fix eventually
# ============================================================================
# These are low-priority items that don't justify a session on their own.
# They get picked up when an agent is in the area for other reasons.
#
# Example:
# [[debt.could]]
# component = "cicada"
# issue = "RSR_OUTLINE.adoc references banned AGPL-3.0"
# effort = "easy"
# impact = "low"
# discovered = "2026-03-23"

# ---------------------------------------------------------------- 2026-09-25
# Found while closing #66 (pages.yml least privilege) and #32 (retire
# instant-sync). None of these were in the blast radius of those two fixes.

[[debt.should]]
component = "cicd/workflows"
issue = "Four workflows still grant a write scope at WORKFLOW level: dependabot-automerge.yml (pull-requests), hypatia-scan.yml (security-events), label-triage.yml and labels.yml (issues). validate-workflow-permissions.sh deliberately does not gate these yet - a gate that fires on accepted practice gets muted. Move each grant to its job, then widen the gate to every write scope."
effort = "easy"
impact = "medium"
priority = "should"
discovered = "2026-09-25"

[[debt.could]]
component = "labels"
issue = ".github/labels.json and .github/label-classifier.json each carry _generated_from = \".github/labels.yml in hyperpolymath/.git-private-farm\", and that repo was retired (standards#106; it 404s). Provenance is now a dangling pointer - the generated artefacts have no reachable source. Re-point at wherever the taxonomy lives now (hyperpolymath/standards carries labels.json + label-classifier.json)."
effort = "medium"
impact = "medium"
priority = "could"
discovered = "2026-09-25"

[[debt.could]]
component = "cicd/justfile"
issue = "Justfile validate-rsr / validate-state / state-touch look for .machine_readable/STATE.a2ml, but the state files live in .machine_readable/6a2/. `just validate` therefore fails closed on files that do not exist and cannot pass as written - a validation target that can never go green."
effort = "easy"
impact = "medium"
priority = "could"
discovered = "2026-09-25"

[[debt.could]]
component = "cicd/workflows"
issue = "CONSUMED 2026-09-25. All four diagnostic probes are retired: zz-m3-no-on.yml and zz-pages-perms-probe.yml were refused by GitHub at startup ('No event triggers defined in `on`', and 'The actions ... are not allowed' for the probe that had no actions.lock section), and zz-m1-plain-push.yml / zz-m5-wrapper-shape.yml were retired with them once the actor-gate question closed -- the answer is recorded in the item below, and neither probe measured anything the shipped workflows do not already cover (m1 was `on: push` + echo, m5 called the same standards reusable as hypatia-scan.yml). The shapes remain one `git show` away if a canary is ever needed."
effort = "easy"
impact = "low"
priority = "could"
discovered = "2026-09-25"

[[debt.could]]
component = "docs/state"
issue = "STATE.a2ml [stats] was last measured 2026-07-11. test-count (693) disagrees with the measurement recorded in #64 (1129 @test occurrences) - the note scopes it to the runtests.jl-wired suites, which nobody has re-counted since. Needs a Julia toolchain to re-measure; ci-workflows was re-measured 2026-09-25 and corrected 19 -> 22 after the probe retirement."
effort = "medium"
impact = "low"
priority = "could"
discovered = "2026-09-25"

# ---------------------------------------------------------------- 2026-09-25
# Found while diagnosing the #108/#110 empty-merge and the remaining red on
# `main`. None of these are fixable from a sandbox with no admin rights.

[[debt.should]]
component = "cicd/actions-lock"
issue = "actions.lock cannot be regenerated here: `gh extension install github/gh-actions-lock` fails with EOF downloading the release asset, so the v4.38.1 entry was hand-derived in the tool's own format (peeled commit of the tag, sha1- prefix, owner_id/repo_id). Any future `uses:` change must run the real `gh actions-lock` where it installs, because GitHub validates the lock itself and refuses the RUN ('Invalid lockfile: The lockfile could not be validated') - which is also the first thing to check when a workflow reports startup_failure."
effort = "easy"
impact = "high"
priority = "should"
discovered = "2026-09-25"

[[debt.should]]
component = "cicd/secret-scanner"
issue = "DIAGNOSED AND ADDRESSED 2026-09-25; verify on the next run. `scan / gitleaks` had been red on every push for as long as the run history goes (back past 2026-09-21). From the job's step conclusions: step 4 'Gitleaks secret scan (gating)' failed, which SKIPPED the AsciiDoc mirror step, so the finding is in a non-.adoc file. Two causes were found, both in the workflow rather than in the tree: (1) the pin (bd0df9ea) predates the estate's shared allowlist, so config/gitleaks/estate-baseline.toml could not be inherited -- and this is a Julia repo, whose Project.toml package UUIDs and Manifest.toml git-tree-sha1 integrity hashes are the baseline's headline false-positive class; (2) that revision ran gitleaks without --verbose, so the log named neither rule, file nor line, which is why days of red produced no triage. Fixed by re-pinning to 210f14e7 (the revision rhodium-standard-repositories' template carries) and adding a minimal .gitleaks.toml that extends the staged baseline. The new revision also adds a gating full-history pass and the AsciiDoc pass is past its grace window, so the scan is now strictly wider: if any finding survives, read the log (it names rule/file/line), remove the value, or -- for a documented false positive only -- add an anchored regexes entry here rather than a paths entry."
effort = "medium"
impact = "high"
priority = "should"
discovered = "2026-09-25"

[[debt.should]]
component = "cicd/mirror"
issue = "mirror.yml is red for 4 of 7 forges: bitbucket, codeberg and disroot exit 128 (SSH key rejected) and gitea exits 1. All four read `secrets.<FORGE>_SSH_KEY` (gitea also `vars.GITEA_HOST`); gitlab, sourcehut and radicle are green. This needs the forge credentials in the org/repo settings, not a code change - the reusable prints a ::notice and skips cleanly when a key is absent, so a red job means the key is present but unauthorised."
effort = "medium"
impact = "medium"
priority = "should"
discovered = "2026-09-25"

[[debt.could]]
component = "cicd/workflows"
issue = "A workflow that GitHub refuses at startup is legible only on the run's HTML page ('Annotations'): `gh api` shows no check run, the annotations endpoint is empty, and `gh run view --log-failed` answers 'log not found'. The three causes measured here (duplicate key, missing `on:`, unvalidated lockfile) are now in .githooks/validate-workflow-yaml.sh, but the next new cause will be just as opaque. Consider a check that fails when a workflow appears in `gh run list` with a path instead of a name."
effort = "medium"
impact = "medium"
priority = "could"
discovered = "2026-09-25"

[[debt.could]]
component = "cicd/gates"
issue = ".githooks/validate-workflow-yaml.sh parses with a python3 + PyYAML heredoc while the estate language policy bans Python with no exceptions (the canonical shell duplicate-key checker lives in standards@092deda scripts/check-workflow-duplicate-keys.sh). The heredoc predates this session; porting the parse step to a bash/awk shape or calling the estate scripts would remove the last Python in the repo's own gates."
effort = "medium"
impact = "low"
priority = "could"
discovered = "2026-09-25"


# ---------------------------------------------------------------- 2026-09-25
# CI access, measured while landing the fix.

[[debt.should]]
component = "cicd/actors"
issue = "GitHub refuses EVERY workflow run triggered by arena-ai-coding-agent[bot] with 'Actor is not allowed to trigger Actions workflows' -- 12 of the 12 runs this account has triggered in this repo are startup_failure, while hyperpolymath's and coderabbitai[bot]'s runs start normally. Consequence for anyone reviewing agent work: a branch pushed by that account shows almost no checks, and none of the repo's Dogfood Gate, Governance or CodeQL jobs can validate an agent's commit. A maintainer has to push an empty commit or dispatch the workflow (or merge and watch main) to get a run. Not repo-fixable: the setting is org-level, and this token (an App installation) cannot read the Actions policy (403) to confirm the allowlist it is checked against."
effort = "easy"
impact = "high"
priority = "should"
discovered = "2026-09-25"

[[debt.could]]
component = "cicd/actions-lock"
issue = "actions.lock is now drift-checked locally (.githooks/validate-actions-lock.sh, offline, bash), but it still cannot be REGENERATED here: the gh-actions-lock release asset will not download (EOF), and there is no Go toolchain to build it. Any change to a 'uses: ref' needs someone with a working `gh actions-lock` to run it, or the same hand-derivation this session did for v4.38.1 (peeled tag commit + owner_id/repo_id, both verifiable through the API)."
effort = "easy"
impact = "medium"
priority = "could"
discovered = "2026-09-25"
